{
  "name": "barberia-operating-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-deployment.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx tests/integration/run.ts",
    "test:hardening": "tsx tests/integration/run-hardening.ts",
    "test:load": "tsx tests/load/run.ts",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config tests/ui/playwright.config.ts",
    "test:booking-ui": "node scripts/qa-website-booking.mjs",
    "test:smoke:production": "node scripts/smoke-production.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "google-auth-library": "11.3.2",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
