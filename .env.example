NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Secret confined to server. Register SHA256 hash in app_private.gateway_credentials.
BOOKING_GATEWAY_SECRET=
WORKER_SECRET=
CRON_SECRET=
SUPABASE_ENVIRONMENT=local
# Required on Vercel Production and Preview. Preview uses a DIFFERENT staging project.
PRODUCTION_SUPABASE_PROJECT_REF=
# Integration tests require an isolated LOCAL database. Never point to production.
TEST_DATABASE_URL=

# Google Calendar is optional; booking works while it is not configured.
# Create a Web OAuth client with redirect APP_URL/api/calendar/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Independent 32-byte hex encryption key and random worker bearer (server only).
# Register the worker hash and Vault dispatcher using scripts/configure-calendar.mjs.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
GOOGLE_CALENDAR_WORKER_SECRET=
